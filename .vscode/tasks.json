      }
    },
    {
      "label": "preview build",
      "type": "shell",
      "command": "npm run build && npm run preview",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "options": {
        "statusbar": {
          "label": "$(globe) Preview Build",
          "detail": "Build and serve the production bundle (localhost:4000)"
        }
      },
      "runOptions": {
        "instanceLimit": 1
      }
    }
  ]
