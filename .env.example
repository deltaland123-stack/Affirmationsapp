# Server-side secrets — copy this file to `.env` for local dev and fill in
# the values. `.env` is gitignored and these are only ever read by the /api/*
# serverless functions (never bundled into client JavaScript — only VITE_*
# variables reach the browser).
#
# On Vercel: do NOT commit these keys. Set them in
#   Project → Settings → Environment Variables
# for the Production (and Preview/Development) environments.

# ElevenLabs Text-to-Speech (api/text-to-speech.js)
ELEVENLABS_API_KEY=

# Optional overrides (safe defaults are used if unset):
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Claude (Anthropic) affirmation generation (api/generate.js)
ANTHROPIC_API_KEY=
