# ElevenLabs Text-to-Speech — SERVER-SIDE ONLY.
# Copy this file to `.env` for local dev and fill in the value. `.env` is
# gitignored and the key is only ever read by the /api/* serverless functions
# (never bundled into client JavaScript — only VITE_* variables reach the browser).
#
# On Vercel: do NOT commit the key. Set it in
#   Project → Settings → Environment Variables → ELEVENLABS_API_KEY
# for the Production (and Preview/Development) environments.

ELEVENLABS_API_KEY=

# Optional overrides (safe defaults are used if unset):
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
